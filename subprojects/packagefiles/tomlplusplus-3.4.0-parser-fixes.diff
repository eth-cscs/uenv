Local fixes to toml++ 3.4.0, applied by subprojects/tomlplusplus.wrap.

Each of these was found by fuzzing uenv's config.toml reader; all of them are
reachable from a user-written configuration file.

1. parser.inl parse_key(): drop the TOML_ASSERT_ASSUME that the current
   character can start a key. parse_table_header() calls parse_key() with
   whatever follows the '[', so a header such as "[\x7f" failed the assertion
   (abort in builds with assertions, undefined behaviour otherwise). The loop
   body already reports the character as a parse error.

2. parser.inl parse_key(): bound the number of segments in a dotted key by
   TOML_MAX_NESTED_VALUES. Every segment nests one table deeper and the table
   tree is walked (update_region_ends) and destroyed recursively, so an
   unbounded key such as "[a.a.a.....]" overflowed the stack.

3. unicode_autogenerated.hpp is_non_ascii_horizontal_whitespace(): the
   generated bitmask sent code points in the first bucket other than U+00A0
   (e.g. U+00C1, reachable from a bare-key position) to TOML_UNREACHABLE.
   Rewritten as the plain comparisons the table encodes.

4. parser.inl parse_date_time(): after the ' '/'T'/'t' separator the time is
   parsed without checking that a digit follows, so "1979-05-27Tx" failed the
   TOML_ASSERT_ASSUME(is_decimal_digit(*cp)) at the top of parse_time().
   Now a parse error.

5. parser.inl parse_value(): the value scanner asserted that the current
   character is not a value terminator, but the rescan that looks for a
   local date-time written with a space ("1979-05-27 5#") can land on one.
   The scanner returns instead.

6. parser.inl parse_value(): asserted that the current character is not a
   value terminator, but parse_array() calls it with anything other than ','
   or ']' ("a = [}" reaches it on the '}'). Now a parse error.

diff -ru a/include/toml++/impl/parser.inl b/include/toml++/impl/parser.inl
--- a/include/toml++/impl/parser.inl	2026-09-13 16:05:09.673431955 +0200
+++ b/include/toml++/impl/parser.inl	2026-09-13 16:32:43.285115715 +0200
@@ -2443,6 +2443,8 @@
 			advance_and_return_if_error_or_eof({});
 
 			// "HH:MM:SS.FFFFFFFFF"
+			if (!is_decimal_digit(*cp))
+				set_error_and_return_default("expected time, saw '"sv, to_sv(*cp), "'"sv);
 			auto time = parse_time(true);
 			return_if_error({});
 
@@ -2546,8 +2548,11 @@
 		{
 			return_if_error({});
 			assert_not_eof();
-			TOML_ASSERT_ASSUME(!is_value_terminator(*cp));
 			push_parse_scope("value"sv);
+			// parse_array() reaches here with any character that is not ',' or ']',
+			// so a stray '}' or '#' is a parse error rather than a precondition.
+			if (is_value_terminator(*cp))
+				set_error_and_return_default("expected value, saw '"sv, to_sv(*cp), "'"sv);
 
 			const depth_counter_scope depth_counter{ nested_values };
 			if TOML_UNLIKELY(nested_values > max_nested_values)
@@ -2631,9 +2636,10 @@
 				bool eof_while_scanning = false;
 				const auto scan			= [&]() noexcept(!TOML_COMPILER_HAS_EXCEPTIONS)
 				{
-					if (is_eof())
+					// the rescan for a date-time with a space can land on a value
+					// terminator (e.g. "1979-05-27 5#"): nothing more to scan.
+					if (is_eof() || is_value_terminator(*cp))
 						return;
-					TOML_ASSERT_ASSUME(!is_value_terminator(*cp));
 
 					do
 					{
@@ -3034,7 +3040,9 @@
 		{
 			return_if_error({});
 			assert_not_eof();
-			TOML_ASSERT_ASSUME(is_bare_key_character(*cp) || is_string_delimiter(*cp));
+			// no assumption about *cp here: parse_table_header() calls this with
+			// whatever follows the '[', and the loop below reports a character that
+			// cannot start a key as a parse error.
 			push_parse_scope("key"sv);
 
 			key_buffer.clear();
@@ -3089,7 +3097,13 @@
 				if (is_eof() || *cp != U'.')
 					break;
 
-				// was a dotted key - go around again
+				// was a dotted key - go around again. every segment nests one table
+				// deeper, and the tables are walked and destroyed recursively, so
+				// bound the depth the same way nested values are bounded.
+				if TOML_UNLIKELY(key_buffer.size() >= max_nested_values)
+					set_error_and_return_default("exceeded maximum dotted key depth of "sv,
+												 max_nested_values,
+												 " (TOML_MAX_NESTED_VALUES)"sv);
 				advance_and_return_if_error_or_eof({});
 				consume_leading_whitespace();
 				set_error_and_return_if_eof({});
diff -ru a/include/toml++/impl/unicode_autogenerated.hpp b/include/toml++/impl/unicode_autogenerated.hpp
--- a/include/toml++/impl/unicode_autogenerated.hpp	2026-09-13 16:05:09.669771491 +0200
+++ b/include/toml++/impl/unicode_autogenerated.hpp	2026-09-13 16:15:39.676365090 +0200
@@ -26,25 +26,14 @@
 	TOML_CONST_GETTER
 	constexpr bool is_non_ascii_horizontal_whitespace(char32_t c) noexcept
 	{
-		// 20 code units from 8 ranges (spanning a search area of 65120)
+		// 20 code units from 8 ranges (spanning a search area of 65120), written
+		// out as plain comparisons.
 
 		if (c < U'\xA0' || c > U'\uFEFF')
 			return false;
 
-		const auto child_index_0 = (static_cast<uint_least64_t>(c) - 0xA0ull) / 0x3FAull;
-		if ((1ull << child_index_0) & 0x7FFFFFFFFFFFF75Eull)
-			return false;
-		if (c == U'\xA0' || c == U'\u3000' || c == U'\uFEFF')
-			return true;
-		switch (child_index_0)
-		{
-			case 0x05: return c == U'\u1680' || c == U'\u180E';
-			case 0x07:
-				return (U'\u2000' <= c && c <= U'\u200B') || (U'\u205F' <= c && c <= U'\u2060') || c == U'\u202F';
-			default: TOML_UNREACHABLE;
-		}
-
-		TOML_UNREACHABLE;
+		return c == U'\xA0' || c == U'\u1680' || c == U'\u180E' || (U'\u2000' <= c && c <= U'\u200B')
+			|| c == U'\u202F' || (U'\u205F' <= c && c <= U'\u2060') || c == U'\u3000' || c == U'\uFEFF';
 	}
 
 	TOML_CONST_GETTER
